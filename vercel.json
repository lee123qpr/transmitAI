{
    "version": 2,
    "cleanUrls": true,
    "functions": {
        "api/*.ts": {
            "maxDuration": 60,
            "includeFiles": "node_modules/pdf-to-img/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/health",
            "destination": "/api/health"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/main"
        },
        {
            "source": "/((?!api|assets|favicon|logo|static).*)",
            "destination": "/index.html"
        }
    ]
}