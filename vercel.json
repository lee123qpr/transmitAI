{
    "version": 2,
    "cleanUrls": true,
    "functions": {
        "api/*.ts": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/health",
            "destination": "/api/health.ts"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/server.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}